# Swiggy Discord Bot - Environment Configuration
# Copy this file to .env locally and fill in your values
# DO NOT commit your .env file with real secrets to Git

# Discord Bot Token
# Get from: https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Developer User IDs (comma-separated)
# These users will have bot owner permissions
DEVELOPER_IDS=your_discord_user_id_here,another_user_id_here

# Supabase project URL for the swind project
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service-role key for this trusted backend worker
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Store only in Railway environment variables or an untracked local .env file.
# Losing it permanently prevents decrypting stored tokens; leaking it compromises them all.
TOKEN_ENCRYPTION_KEY=64_character_hex_key_generated_once

# OpenRouter API Key (if using LLM features)
# Get from: https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OAuth 2.1 Callback URL
# Local development: http://localhost:3000/auth/callback
# Production (Railway): https://your-railway-url.railway.app/auth/callback
OAUTH_CALLBACK_URL=http://localhost:3000/auth/callback

# Optional: Port for OAuth callback server (default: 3000)
# OAUTH_PORT=3000

# Optional: Supabase keepalive heartbeat (default: every 6h)
# Prevents Free-plan auto-pause after ~7d idle. Set to "true" to disable.
# SUPABASE_KEEPALIVE_DISABLED=false
# SUPABASE_KEEPALIVE_INTERVAL_MS=21600000
